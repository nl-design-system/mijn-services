{
  "version": "1.0.0-alpha.0",
  "author": "Community for NL Design System",
  "description": "Design system based on the NL Design System architecture",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/services.git",
    "directory": "."
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=24 <=25",
    "pnpm": "^11.4.0"
  },
  "workspaces": [
    "./packages/*"
  ],
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@changesets/cli": "3.0.1",
    "@types/node": "24.13.2",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-react": "7.37.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "markdownlint-cli": "0.49.1",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "11.0.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.15",
    "prettier": "3.9.7",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "backup-discussions": "pnpm --filter @vng.nl/gh-discussions-backup-tool run backup",
    "build": "pnpm --recursive run build",
    "clean": "pnpm --recursive run clean",
    "lint": "npm-run-all --continue-on-error lint:** lint-workspaces",
    "lint:css": "stylelint --allow-empty-input '**/*.{css,scss}'",
    "lint:js": "eslint --ext .js,.cjs,.mjs,.json,.jsx,.mdx,.ts,.tsx --report-unused-disable-directives .",
    "lint:md": "markdownlint '**/*.md'",
    "lint:package-json": "npmPkgJsonLint .",
    "lint:package-lock": "pnpm ls --recursive",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:** prettier",
    "lint-fix:css": "stylelint --fix '**/*.{css,scss}'",
    "lint-fix:js": "eslint --ext .js,.cjs,.mjs,.json,.jsx,.mdx,.ts,.tsx --fix --report-unused-disable-directives .",
    "lint-fix:md": "markdownlint --fix '**/*.md'",
    "lint-workspaces": "pnpm --recursive --if-present run lint",
    "lint-build": "pnpm --recursive --if-present run lint-build",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "changeset": "changeset add",
    "changeset:empty": "changeset --empty",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since origin/main",
    "start": "node_modules/http-server/bin packages/storybook/dist/",
    "storybook": "npm-run-all --parallel watch:**",
    "test": "pnpm run test-workspaces",
    "test-update": "npm-run-all --sequential clean lint build test",
    "test-workspaces": "pnpm --recursive --if-present run test",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs",
    "watch:storybook": "pnpm --filter ./packages/storybook run storybook",
    "website": "pnpm --filter website run dev",
    "website:build": "pnpm --filter website run build"
  },
  "dependencies": {
    "http-server": "14.1.1"
  }
}
